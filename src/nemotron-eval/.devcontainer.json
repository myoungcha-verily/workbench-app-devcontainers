{
    "name": "Nemotron Eval Terminal",
    "dockerComposeFile": "docker-compose.yaml",
    "service": "app",
    "shutdownAction": "none",
    "workspaceFolder": "/workspace",
    "postCreateCommand":
        "./startupscript/post-startup.sh nemotron /home/nemotron \"${templateOption:cloud}\" \"${templateOption:login}\" && ./scripts/start-services.sh nemotron /home/nemotron",
    "postStartCommand":
        "./startupscript/remount-on-restart.sh nemotron /home/nemotron \"${templateOption:cloud}\" \"${templateOption:login}\" && ./scripts/start-services.sh nemotron /home/nemotron",
    "features": {
        "ghcr.io/dhoeric/features/google-cloud-cli@sha256:fa5d894718825c5ad8009ac8f2c9f0cea3d1661eb108a9d465cba9f3fc48965f": {},
        "./.devcontainer/features/workbench-tools": {
            "cloud": "${templateOption:cloud}",
            "username": "nemotron",
            "userHomeDir": "/home/nemotron"
        },
        "./.devcontainer/features/wb-mcp-server": {
            "username": "nemotron",
            "userHomeDir": "/home/nemotron"
        },
        "./.devcontainer/features/llm-context": {
            "username": "nemotron",
            "userHomeDir": "/home/nemotron"
        }
    },
    "remoteUser": "root"
}
